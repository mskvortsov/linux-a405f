#
# Samsung Exynos 7885 - Kernel Configuration Fragment.
#
# Location: arch/arm64/configs/exynos7885.config
# To generate the full config, run:
#     make defconfig exynos7870.config exynos7885.config
#
CONFIG_LOCALVERSION="-exynos7885"

CONFIG_TOUCHSCREEN_S6SY761=m
# CONFIG_MFD_SEC_CORE is not set
CONFIG_MFD_S2MPU08=m
# CONFIG_REGULATOR_S2MPS11 is not set
CONFIG_REGULATOR_S2MPU08=m
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=m
CONFIG_BATTERY_S2MU106=y

CONFIG_ARM_EXYNOS_ACPM_CPUFREQ=y
CONFIG_EXTRA_FIRMWARE="exynos7885_acpm_fvp.fw"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

CONFIG_DRM_EXYNOS=m
CONFIG_DRM_SAMSUNG_DSIM=m
CONFIG_DRM_PANEL_SAMSUNG_S6E8FC0=m

CONFIG_DEVFREQ_THERMAL=y

CONFIG_CHARGER_S2MU106=y
