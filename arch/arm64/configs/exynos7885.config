#
# Samsung Exynos 7885 - Kernel Configuration Fragment.
#
# Location: arch/arm64/configs/exynos7885.config
# To generate the full config, run:
#     make defconfig exynos7870.config exynos7885.config
#
CONFIG_LOCALVERSION="-exynos7885"

CONFIG_TOUCHSCREEN_S6SY761=m
# CONFIG_MFD_SEC_CORE is not set
CONFIG_MFD_S2MPU08=m
# CONFIG_REGULATOR_S2MPS11 is not set
CONFIG_REGULATOR_S2MPU08=m
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_MCU_IPC=y
CONFIG_EXYNOS_ACPM_PROTOCOL=m
CONFIG_BATTERY_S2MU106=y

CONFIG_ARM_EXYNOS_ACPM_CPUFREQ=y
CONFIG_EXTRA_FIRMWARE="exynos7885_acpm_fvp.fw"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

CONFIG_DRM_EXYNOS=m
CONFIG_DRM_SAMSUNG_DSIM=m
CONFIG_DRM_PANEL_SAMSUNG_S6E8FC0=m

CONFIG_DEVFREQ_THERMAL=y

CONFIG_CHARGER_S2MU106=y

# SCSC Maxwell (WLBT) WiFi+BT driver. CFG80211 and BT are already on by
# default; EXYNOS_ACPM_PROTOCOL above satisfies its other hard Kconfig
# dependency. BT_LE/6LOWPAN/BT_6LOWPAN are for the BLE 6LoWPAN/IPv6
# data path specifically, not needed by the base driver.
CONFIG_SCSC_MX=m
CONFIG_BT_LE=y
CONFIG_6LOWPAN=m
CONFIG_BT_6LOWPAN=m

# Kepler GNSS bring-up driver, see gnss.md. Module, same reason as
# SCSC_MX -- fast reload while probing PMU/mailbox sequencing.
CONFIG_GNSS_KEPLER=m

# CP (modem) PMU-only bring-up probe, see gnss.md. Not a modem driver;
# isolates whether CENTRAL_SEQ_CP_STATUS is unreachable purely because
# the CP domain has never been PMU-sequenced.
CONFIG_CP_PMU_PROBE=m
CONFIG_WWAN=m
CONFIG_SAMSUNG_SBD=m
CONFIG_EXYNOS_CP_REMOTEPROC=m

# Automatic recovery from a stall. gnss.md records three incidents that
# each needed a physical power cycle because nothing here reboots the
# board on its own: the level-triggered ACTIVE interrupt storm in
# milestone 1, and both PMU_ALIVE register-probe hangs ("Tried a
# brute-force PMU_ALIVE register diff").
#
# The SoC watchdog block is already described and enabled
# ("samsung,exynos8-wdt", `&watchdog { status = "okay"; }` in
# exynos7885-a40.dts, timeout-sec = 30), but s3c2410_wdt explicitly
# *stops* the counter at probe unless its `tmr_atboot` module parameter
# is set -- hence the "watchdog inactive, reset disabled" line in every
# boot log so far. That parameter is not settable from here: this board
# takes its cmdline from U-Boot (`setenv bootargs` in /boot/boot.cmd),
# which overwrites the dts `chosen` node's bootargs, and arm64 has no
# CMDLINE_EXTEND to append to it. So the switch lives on the device:
#
#     setenv bootargs root=... s3c2410_wdt.tmr_atboot=1
#     mkimage -C none -A arm64 -T script -d /boot/boot.cmd /boot/boot.scr
#
# With that set the driver starts the counter and sets WDOG_HW_RUNNING,
# which makes WATCHDOG_HANDLE_BOOT_ENABLED (already =y by default) feed
# it from the watchdog core's SCHED_FIFO "watchdogd" kthread every
# timeout/2 = 15s, with no userspace daemon involved. Anything that
# stops that kthread for 30s is a hardware reset. WATCHDOG_SYSFS is for
# checking the result: /sys/class/watchdog/watchdog0/state should read
# "active", and `bootstatus` distinguishes a watchdog reset from a
# normal reboot (the exynos8 variant reads PMU RST_STAT bit 24).
CONFIG_WATCHDOG_SYSFS=y

# The hardware watchdog above only catches a stall that takes the whole
# system down: "watchdogd" is not CPU-bound, so a single livelocked core
# -- exactly the milestone-1 ACTIVE storm, which pinned "whatever CPU
# served it" -- can still be fed from another core and never trip it.
# These turn a per-CPU lockup into a panic instead, which PANIC_TIMEOUT
# then turns into a reboot. HARDLOCKUP_DETECTOR resolves to the buddy
# implementation here (HAVE_HARDLOCKUP_DETECTOR_BUDDY, no perf/NMI on
# this SoC): each CPU is checked by another one, so it also covers a CPU
# wedged with interrupts off -- the suspected failure mode of the
# CENTRAL_SEQ_CP_STATUS read. Both are runtime-tunable if they turn out
# to be twitchy on a device this printk-heavy: sysctl
# kernel.softlockup_panic=0 / kernel.nmi_watchdog=0.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_PANIC_TIMEOUT=10

# EROFS: the A40 vendor partition is erofs; needed to read the stock
# gpsd and firmware off the device rather than trusting a host-side dump.
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_ZIP=y
CONFIG_XZ_DEC_MICROLZMA=y
