/dts-v1/;
#include "exynos7885.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy A40";
	compatible = "samsung,a40", "samsung,exynos7885";
	chassis-type = "handset";

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		stdout-path = "fb0";

		bootargs = "pmos.nosplash clk_ignore_unused pd_ignore_unused";

		linux,initrd-start = <0x89000000>;
		linux,initrd-end = <0x898FFFFF>;


		fb0: framebuffer@ec000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xec000000 (1080 * 2340 * 4)>;
			width = <1080>;
			height = <2340>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Firmware-owned regions taken verbatim from the downstream
		 * (4.4) device tree's /reserved-memory. Leaving any of these
		 * out lets Linux hand the RAM to the page allocator while the
		 * secure firmware / modem (CP) keep writing to it, which
		 * intermittently corrupts whatever the kernel placed there
		 * (e.g. the unpacked initramfs -> random "Exec format error").
		 */
		sec_debug_magic_rmem: sec-debug-magic@80000000 {
			reg = <0x0 0x80000000 0x1000>;
		};

		dram_test_rmem: dram-test@80002000 {
			reg = <0x0 0x80002000 0x2000>;
		};

		/*
		 * Exynos Snapshot (ESS / debug-snapshot). Downstream passes
		 * ess_setup=0x86000000 on the cmdline; the ess driver then
		 * memblock_reserve()s a block sized by its item table (up to
		 * log_kevents 8M + log_kernel 2M + log_platform 4M + log_sfr 4M
		 * + log_etm 8M + 2M header ~= 28M). It is NOT in the downstream
		 * /reserved-memory, so copying that node alone missed it. The
		 * ETR/coresight + secure firmware keep writing here regardless
		 * of the running OS, so leave a generous 32M hole. Ends at
		 * 0x88000000, below the wrapper's initrd (0x89000000).
		 */
		ess_rmem: exynos-snapshot@86000000 {
			reg = <0x0 0x86000000 0x2000000>;
			no-map;
		};

		tima_rmem: tima@b8000000 {
			reg = <0x0 0xb8000000 0x200000>;
		};

		/*
		 * Secure-world / TEE carve-out at the very top of the low
		 * DRAM bank (0x80000000 + 0x3da00000 = 0xbda00000). S-Boot /
		 * EL3 owns 0xbbc00000-0xbda00000 (top 30 MiB) and writes to
		 * it independently of the running OS. The downstream
		 * bootloader reserves it at runtime, so it is NOT present in
		 * the downstream DT /reserved-memory we copied. Found
		 * empirically with memtest=17 - it is the only RAM range that
		 * fails the pattern test. Leaving it usable let Linux place
		 * page-cache (the unpacked initramfs) there, which the secure
		 * world then zeroed -> intermittent "Exec format error" /
		 * page-granular all-zero files during early boot.
		 */
		secure_dram_rmem: secure-dram@bbc00000 {
			reg = <0x0 0xbbc00000 0x1e00000>;
			no-map;
		};

		seclog_rmem: seclog@c0000000 {
			reg = <0x0 0xc0000000 0x80000>;
		};

		/*
		 * Legacy /memreserve/ 0xE0000000 0xD00000 from the downstream
		 * exynos7885-rmem.dtsi (secure firmware / iommu owned).
		 */
		secfw_rmem: secfw@e0000000 {
			reg = <0x0 0xe0000000 0xd00000>;
			no-map;
		};

		wifibt_rmem: wifibt@e9000000 {
			reg = <0x0 0xe9000000 0x400000>;
		};

		abox_rmem: abox@e9400000 {
			reg = <0x0 0xe9400000 0x400000>;
		};

		framebuffer_region@ec000000 {
			reg = <0x0 0xec000000 0x1400000>;
			no-map;
		};

		/* modem_if: downstream size is 0x8800000 (ends 0xfdc00000) */
		modem_rmem: modem@f5400000 {
			reg = <0x0 0xf5400000 0x8800000>;
		};

		cp_ram_logging_rmem: cp-ram-logging@fdc00000 {
			reg = <0x0 0xfdc00000 0x2000000>;
		};

		gnss_rmem: gnss@ffc00000 {
			reg = <0x0 0xffc00000 0x400000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3da00000>,
		      <0x0 0xc0000000 0x40000000>,
		      <0x8 0x80000000 0x80000000>;
	};

	reg_dummy: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "dummy_reg";
	};

	tsp_avdd: tsp-avdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_avdd";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpg2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_power &key_voldown &key_volup>;

		key-power {
			label = "gpio-keys: KEY_POWER";
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
		};

		key-voldown {
			label = "gpio-keys: KEY_VOLUMEDOWN";
			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		key-volup {
			label = "gpio-keys: KEY_VOLUMEUP";
			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};


	/*tsp_ldo_en: tsp_ldo_en {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpg2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
//		regulator-boot-on;
	};*/
};

&i2c_4 {
	#address-cells = <1>;
	#size-cells = <0>;
	samsung,i2c-sda-delay = <0x64>;
	samsung,i2c-max-bus-freq = <0x61a80>;

	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532";
		reg = <0x20>;

		interrupt-parent = <&gpa0>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq>;
		pinctrl-1 = <&touch_input>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2340>;
		vdd-supply = <&tsp_avdd>;

	};
};

/*&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;

	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532";
		reg = <0x20>;
		interrupt-parent = <&gpa0>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2340>;

		vdd-supply = <&vdd_ldo34>;
	};
};*/

&pinctrl_alive {
	touch_irq: touch-irq-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	touch_input: touch-input {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	key_power: key-power-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-7";
	};

	key_voldown: key-voldown-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-6";
	};

	key_volup: key-volup-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-5";
	};

	pmic_irq: pmic-irq-pins {
		samsung,pins = "gpa2-0";
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

};

&oscclk {
	clock-frequency = <0x18cba80>;
};

&mmc_0 {
	status = "okay";
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-highspeed;
	non-removable;
	mmc-hs400-enhanced-strobe;
	card-detect-delay = <200>;
	clock-frequency = <800000000>;
	bus-width = <8>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 4>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	samsung,dw-mshc-hs400-timing = <0 2>;

	pinctrl-names = "default";
	pinctrl-0 = <&sd0_clk_fast_slew_rate_3x &sd0_cmd &sd0_rdqs
		     &sd0_bus1 &sd0_bus4 &sd0_bus8>;
};

&usbdrd {
	status = "okay";
	vdd10-supply = <&reg_dummy>;
	vdd33-supply = <&reg_dummy>;
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	snps,quirk-frame-length-adjustment = <0x20>;
};

&usbdrd_phy {
	status = "okay";
};

&pinctrl_top {
	pm_wrsti: pm-wrsti-pins {
		samsung,pins = "gpg1-1";
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
	};
};

/*
 * S2MPU08 PMIC, reached over ACPM (not I2C/SPEEDY as downstream). Rail
 * map (names, voltages, always-on) taken from the running downstream
 * device tree (/proc/device-tree/.../s2mpu08mfd@00/regulators). Existing
 * consumers still use reg_dummy as a fallback until this is confirmed
 * probing.
 */
&acpm_ipc {
	mfd@1 {
		compatible = "samsung,s2mpu08";
		reg = <0x1>;

		interrupt-parent = <&gpa2>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq &pm_wrsti>;

		s2mpu08,wakeup = "enabled";

		regulators {
			/*
			 * Per-rail constraints derived from a live PMIC dump.
			 * No rail carries a voltage range, so the core never
			 * calls set_voltage(): BUCK1-6 are ACPM/DVFS-owned (the
			 * live voltage is not in the register the descriptor
			 * reads) and the rest are left at their boot voltage.
			 * regulator-always-on is set on the rails the dump showed
			 * enabled. The s2mpu08 driver makes BUCK enable a no-op
			 * (ACPM owns the bucks on mainline), so always-on on a
			 * buck does not flip its control mode and brown it out;
			 * the LDOs are already in the on-mode that enable writes,
			 * so enabling them is a no-op too.
			 */
			buck1_reg: BUCK1 {
				regulator-name = "vdd_mif";
				regulator-always-on;
			};

			buck2_reg: BUCK2 {
				regulator-name = "vdd_cpucl0";
				regulator-always-on;
			};

			buck3_reg: BUCK3 {
				regulator-name = "vdd_cpucl1_2";
				regulator-always-on;
			};

			buck4_reg: BUCK4 {
				regulator-name = "vdd_int";
				regulator-always-on;
			};

			buck5_reg: BUCK5 {
				regulator-name = "vdd_g3d";
			};

			buck6_reg: BUCK6 {
				regulator-name = "vdd2_mem";
				regulator-always-on;
			};

			buck7_reg: BUCK7 {
				regulator-name = "vdd_lldo";
			};

			buck8_reg: BUCK8 {
				regulator-name = "vdd_mldo";
				regulator-always-on;
			};

			ldo1_reg: LDO1 {
				regulator-name = "vdd_ldo1";
			};

			ldo2_reg: LDO2 {
				regulator-name = "vqmmc";
			};

			ldo3_reg: LDO3 {
				regulator-name = "vdd_ldo3";
				regulator-always-on;
			};

			ldo4_reg: LDO4 {
				regulator-name = "vdd_ldo4";
				regulator-always-on;
			};

			ldo5_reg: LDO5 {
				regulator-name = "vdd_ldo5";
				regulator-always-on;
			};

			ldo6_reg: LDO6 {
				regulator-name = "vdd_ldo6";
				regulator-always-on;
			};

			ldo7_reg: LDO7 {
				regulator-name = "vdd_ldo7";
				regulator-always-on;
			};

			ldo8_reg: LDO8 {
				regulator-name = "vdd_ldo8";
				regulator-always-on;
			};

			ldo9_reg: LDO9 {
				regulator-name = "vdd_ldo9";
				regulator-always-on;
			};

			ldo10_reg: LDO10 {
				regulator-name = "vdd_ldo10";
				regulator-always-on;
			};

			ldo11_reg: LDO11 {
				regulator-name = "vdd_ldo11";
				regulator-always-on;
			};

			ldo12_reg: LDO12 {
				regulator-name = "vdd_ldo12";
				regulator-always-on;
			};

			ldo13_reg: LDO13 {
				regulator-name = "vdd_ldo13";
				regulator-always-on;
			};

			ldo14_reg: LDO14 {
				regulator-name = "vdd_ldo14";
				regulator-always-on;
			};

			ldo33_reg: LDO33 {
				regulator-name = "vdd_ldo33";
			};

			ldo34_reg: LDO34 {
				regulator-name = "vdd_ldo34";
			};

			ldo35_reg: LDO35 {
				regulator-name = "vmmc";
			};

			ldo36_reg: LDO36 {
				regulator-name = "vdd_ldo36";
			};

			ldo37_reg: LDO37 {
				regulator-name = "vdd_ldo37";
			};
		};
	};
};
