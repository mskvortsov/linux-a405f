// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "exynos7885.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy A40";
	compatible = "samsung,a40", "samsung,exynos7885";
	chassis-type = "handset";

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		stdout-path = "fb0";

		bootargs = "pmos.nosplash clk_ignore_unused pd_ignore_unused";

		linux,initrd-start = <0x89000000>;
		linux,initrd-end = <0x898FFFFF>;


		fb0: framebuffer@ec000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xec000000 (1080 * 2340 * 4)>;
			width = <1080>;
			height = <2340>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Firmware-owned regions taken verbatim from the downstream
		 * (4.4) device tree's /reserved-memory. Leaving any of these
		 * out lets Linux hand the RAM to the page allocator while the
		 * secure firmware / modem (CP) keep writing to it, which
		 * intermittently corrupts whatever the kernel placed there
		 * (e.g. the unpacked initramfs -> random "Exec format error").
		 */
		sec_debug_magic_rmem: sec-debug-magic@80000000 {
			reg = <0x0 0x80000000 0x1000>;
		};

		dram_test_rmem: dram-test@80002000 {
			reg = <0x0 0x80002000 0x2000>;
		};

		/*
		 * S-Boot's RAM log: "LOGM" magic at 0x91200204, ring buffer
		 * 0x91300000-0x91500000. U-Boot does not load anything there,
		 * so keeping Linux off it preserves this boot's bootloader log
		 * for reading through /dev/mem.
		 */
		sboot_log_rmem: sboot-log@91200000 {
			reg = <0x0 0x91200000 0x300000>;
			no-map;
		};

		/*
		 * Exynos Snapshot (ESS / debug-snapshot). Downstream passes
		 * ess_setup=0x86000000 on the cmdline; the ess driver then
		 * memblock_reserve()s a block sized by its item table (up to
		 * log_kevents 8M + log_kernel 2M + log_platform 4M + log_sfr 4M
		 * + log_etm 8M + 2M header ~= 28M). It is NOT in the downstream
		 * /reserved-memory, so copying that node alone missed it. The
		 * ETR/coresight + secure firmware keep writing here regardless
		 * of the running OS, so leave a generous 32M hole. Ends at
		 * 0x88000000, below the wrapper's initrd (0x89000000).
		 */
		ess_rmem: exynos-snapshot@86000000 {
			reg = <0x0 0x86000000 0x2000000>;
			no-map;
		};

		tima_rmem: tima@b8000000 {
			reg = <0x0 0xb8000000 0x200000>;
		};

		/*
		 * Secure-world / TEE carve-out at the very top of the low
		 * DRAM bank (0x80000000 + 0x3da00000 = 0xbda00000). S-Boot /
		 * EL3 owns 0xbbc00000-0xbda00000 (top 30 MiB) and writes to
		 * it independently of the running OS. The downstream
		 * bootloader reserves it at runtime, so it is NOT present in
		 * the downstream DT /reserved-memory we copied. Found
		 * empirically with memtest=17 - it is the only RAM range that
		 * fails the pattern test. Leaving it usable let Linux place
		 * page-cache (the unpacked initramfs) there, which the secure
		 * world then zeroed -> intermittent "Exec format error" /
		 * page-granular all-zero files during early boot.
		 */
		secure_dram_rmem: secure-dram@bbc00000 {
			reg = <0x0 0xbbc00000 0x1e00000>;
			no-map;
		};

		seclog_rmem: seclog@c0000000 {
			reg = <0x0 0xc0000000 0x80000>;
		};

		/*
		 * Legacy /memreserve/ 0xE0000000 0xD00000 from the downstream
		 * exynos7885-rmem.dtsi (secure firmware / iommu owned).
		 */
		secfw_rmem: secfw@e0000000 {
			reg = <0x0 0xe0000000 0xd00000>;
			no-map;
		};

		/*
		 * Shared with the WLBT R4/M4, which master into it directly
		 * and are not coherent with AP caches: no-map keeps it out
		 * of the kernel linear mapping so the driver can map it
		 * write-combining and have the firmware image actually land
		 * in DRAM.
		 */
		wifibt_rmem: wifibt@e9000000 {
			reg = <0x0 0xe9000000 0x400000>;
			no-map;
		};

		abox_rmem: abox@e9400000 {
			reg = <0x0 0xe9400000 0x400000>;
		};

		framebuffer_region@ec000000 {
			reg = <0x0 0xec000000 0x1400000>;
			no-map;
		};

		/* modem_if: downstream size is 0x8800000 (ends 0xfdc00000) */
		modem_rmem: modem@f5400000 {
			reg = <0x0 0xf5400000 0x8800000>;
		};

		cp_ram_logging_rmem: cp-ram-logging@fdc00000 {
			reg = <0x0 0xfdc00000 0x2000000>;
		};

		/*
		 * Shared with the Kepler GNSS core. Deliberately *not*
		 * no-map: marking it no-map made the early memblock
		 * reservation itself fail at boot ("OF: reserved mem:
		 * Reserved memory: failed to reserve memory for node
		 * 'gnss@ffc00000'"), reproducibly, and adding no-map to
		 * the preceding regions to rule out an adjacency effect
		 * didn't fix it either -- a real memblock-level quirk, not
		 * yet root-caused (see gnss.md). Left as a plain reserve()
		 * like modem_rmem/cp_ram_logging_rmem above, which has
		 * always worked reliably here; the driver uses memremap()
		 * rather than ioremap_wc() to match (ioremap's PFN-is-RAM
		 * refusal applies regardless of no-map once excluded from
		 * the linear map, but with the region left mapped normally
		 * memremap()'s RAM-aware path is the correct tool anyway).
		 */
		gnss_rmem: gnss@ffc00000 {
			reg = <0x0 0xffc00000 0x400000>;
		};

		/*
		 * Debug only: ramoops/pstore region in the gap after the ESS
		 * carve-out (ends at 0x88000000) and before the wrapper's
		 * initrd (0x89000000).
		 */
		ramoops@88400000 {
			compatible = "ramoops";
			reg = <0x0 0x88400000 0x200000>;
			console-size = <0x100000>;
			record-size = <0x40000>;
			pmsg-size = <0x40000>;
			ecc-size = <16>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3da00000>,
		      <0x0 0xc0000000 0x40000000>,
		      <0x8 0x80000000 0x80000000>;
	};

	reg_dummy: regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "dummy_reg";
	};

	/*
	 * Cell parameters from the downstream battery_data_a40_common.dtsi:
	 * 3100 mAh pack, 4.35 V float (battery,chg_float_voltage). Consumed by
	 * the S2MU106 fuel gauge and charger via monitored-battery.
	 *
	 * constant-charge-current-max-microamp and charge-term-current-microamp
	 * aren't in the downstream DT (they come from a cable-type current
	 * table the charger driver doesn't implement yet); these are
	 * conservative MVP defaults, not vendor-supplied values.
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3100000>;
		voltage-max-design-microvolt = <4350000>;
		voltage-min-design-microvolt = <3400000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		constant-charge-current-max-microamp = <1000000>;
		charge-term-current-microamp = <150000>;
	};

	tsp_avdd: tsp-avdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_avdd";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpg2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&key_power &key_voldown &key_volup>;

		key-power {
			label = "gpio-keys: KEY_POWER";
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
		};

		key-voldown {
			label = "gpio-keys: KEY_VOLUMEDOWN";
			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		key-volup {
			label = "gpio-keys: KEY_VOLUMEUP";
			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};


	/*tsp_ldo_en: tsp_ldo_en {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpg2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
//		regulator-boot-on;
	};*/
};

/*
 * S2MU106 PMIC fuel gauge. Downstream puts it on i2c_0 (the s3c2440 I2C
 * controller at 0x13830000); its alert line is on gpa2-4. The MUIC and
 * USB-PD blocks of the same PMIC are not wired up here; the charger block
 * is (see &i2c_1 below).
 */
&i2c_0 {
	#address-cells = <1>;
	#size-cells = <0>;
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	fuel-gauge@3b {
		compatible = "samsung,s2mu106-fuel-gauge";
		reg = <0x3b>;

		interrupt-parent = <&gpa2>;
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&fuel_irq>;

		monitored-battery = <&battery>;
	};
};

/*
 * S2MU106 PMIC charger block, at its own i2c address on a separate bus
 * from the fuel gauge (matches downstream). Its IRQ line is shared with
 * the MUIC/AFC/PM/haptic-boost blocks of the same PMIC; those aren't
 * wired up here, so the charger driver masks them off at the top-level
 * demux and only listens for its own events.
 */
&i2c_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	charger@3d {
		compatible = "samsung,s2mu106-charger";
		reg = <0x3d>;

		interrupt-parent = <&gpa2>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&if_pmic_irq>;

		monitored-battery = <&battery>;
	};
};

&i2c_4 {
	#address-cells = <1>;
	#size-cells = <0>;
	samsung,i2c-sda-delay = <0x64>;
	samsung,i2c-max-bus-freq = <0x61a80>;

	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532";
		reg = <0x20>;

		interrupt-parent = <&gpa0>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq>;
		pinctrl-1 = <&touch_input>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2340>;
		vdd-supply = <&tsp_avdd>;

	};
};

/*&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;

	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532";
		reg = <0x20>;
		interrupt-parent = <&gpa0>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2340>;

		vdd-supply = <&vdd_ldo34>;
	};
};*/

&pinctrl_alive {
	touch_irq: touch-irq-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	touch_input: touch-input {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	key_power: key-power-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-7";
	};

	key_voldown: key-voldown-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-6";
	};

	key_volup: key-volup-pins {
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pins = "gpa1-5";
	};

	pmic_irq: pmic-irq-pins {
		samsung,pins = "gpa2-0";
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	/* S2MU106 fuel gauge alert (downstream pulls this up). */
	fuel_irq: fuel-irq-pins {
		samsung,pins = "gpa2-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	/* S2MU106 charger/MUIC/AFC/PM top-level IRQ demux line. */
	if_pmic_irq: if-pmic-irq-pins {
		samsung,pins = "gpa2-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

};

&oscclk {
	clock-frequency = <0x18cba80>;
};

&mmc_0 {
	status = "okay";
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	cap-mmc-highspeed;
	non-removable;
	mmc-hs400-enhanced-strobe;
	card-detect-delay = <200>;
	clock-frequency = <800000000>;
	bus-width = <8>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 4>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	samsung,dw-mshc-hs400-timing = <0 2>;

	pinctrl-names = "default";
	pinctrl-0 = <&sd0_clk_fast_slew_rate_3x &sd0_cmd &sd0_rdqs
		     &sd0_bus1 &sd0_bus4 &sd0_bus8>;
};

&usbdrd {
	status = "okay";
	vdd10-supply = <&reg_dummy>;
	vdd33-supply = <&reg_dummy>;
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	snps,quirk-frame-length-adjustment = <0x20>;
};

&usbdrd_phy {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&soc {
	/*
	 * SCSC "Maxwell" WLBT (WiFi/BT combo) companion chip.
	 * Two register windows (R4 and M4 mailbox/control SFRs); only
	 * the R4 side raises an interrupt to the AP today. Power/reset
	 * sequencing goes through PMU_ALIVE via the syscon phandle below
	 * (WIFI_CTRL_NS/S at PMU offsets 0x140/0x144), same block used
	 * to gate the ACPM CM4.
	 */
	scsc_wifibt: wifibt@120c0000 {
		compatible = "samsung,exynos7885-scsc-wifibt";
		reg = <0x120c0000 0x180>, /* R4 */
		      <0x120e0000 0x180>; /* M4 */
		interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 286 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mbox", "alive", "wdog";
		samsung,syscon-phandle = <&pmu_system_controller>;
		memory-region = <&wifibt_rmem>;
		/*
		 * Vendor platform_mif_reset() sends an ACPM DVFS "SET_FLAG"
		 * request (id=7) on this same channel cpufreq uses, right
		 * before releasing PMU reset -- believed to guard a shared
		 * rail (BUCK2/vdd_cpucl0) from an inrush-current dip.
		 */
		samsung,acpm-ipc = <&acpm_ipc>;
		samsung,acpm-dvfs-channel = <0>;
		status = "okay";
	};

	/*
	 * Samsung "Kepler" GNSS companion chip. MCU_IPC mailbox window
	 * (milestone 2: one BCMD send, see drivers/misc/samsung/gnss_kepler/
	 * and gnss.md). Power/reset sequencing goes through PMU_ALIVE via
	 * the same syscon phandle WLBT uses above (GNSS_CTRL_NS/S at PMU
	 * offsets 0x40/0x44). "active"/"watchdog"/"mbox" match the
	 * downstream gnss_pdata/mailbox_gnss nodes' interrupt-names;
	 * "wakeup" isn't wired up yet.
	 */
	gnss_kepler: gnss@120d0000 {
		compatible = "samsung,exynos7885-gnss-kepler";
		reg = <0x120d0000 0x180>;
		interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 165 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "active", "watchdog", "mbox";
		samsung,syscon-phandle = <&pmu_system_controller>;
		memory-region = <&gnss_rmem>;
		status = "okay";
	};

	/*
	 * CP (modem) PMU-only bring-up probe, see gnss.md and
	 * drivers/misc/samsung/cp_pmu_probe/. No IP block of its own --
	 * it only touches the shared PMU_ALIVE syscon above, so no `reg`.
	 */
	cp_pmu_probe: cp-pmu-probe {
		compatible = "samsung,exynos7885-cp-pmu-probe";
		samsung,syscon-phandle = <&pmu_system_controller>;
		status = "okay";
	};
};

&pinctrl_top {
	pm_wrsti: pm-wrsti-pins {
		samsung,pins = "gpg1-1";
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
	};
};

&decon {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	panel@0 {
		compatible = "samsung,s6e8fc0-a40";
		reg = <0>;

		vdd3p0-supply = <&reg_dummy>;
		reset-gpios = <&gpg2 0 GPIO_ACTIVE_HIGH>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_to_panel>;
			};
		};
	};
};

&{/soc@0/dsi@14870000/ports} {
	port@1 {
		reg = <1>;

		dsi_to_panel: endpoint {
			remote-endpoint = <&panel_in>;
			data-lanes = <1 2 3 4>;
		};
	};
};

/*
 * S2MPU08 PMIC, reached over ACPM (not I2C/SPEEDY as downstream). Rail
 * map (names, voltages, always-on) taken from the running downstream
 * device tree (/proc/device-tree/.../s2mpu08mfd@00/regulators). Existing
 * consumers still use reg_dummy as a fallback until this is confirmed
 * probing.
 */
&acpm_ipc {
	mfd@1 {
		compatible = "samsung,s2mpu08";
		reg = <0x1>;

		interrupt-parent = <&gpa2>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq &pm_wrsti>;

		s2mpu08,wakeup = "enabled";

		regulators {
			/*
			 * Per-rail constraints derived from a live PMIC dump.
			 * No rail carries a voltage range, so the core never
			 * calls set_voltage(): BUCK1-6 are ACPM/DVFS-owned (the
			 * live voltage is not in the register the descriptor
			 * reads) and the rest are left at their boot voltage.
			 * regulator-always-on is set on the rails the dump showed
			 * enabled. The s2mpu08 driver makes BUCK enable a no-op
			 * (ACPM owns the bucks on mainline), so always-on on a
			 * buck does not flip its control mode and brown it out;
			 * the LDOs are already in the on-mode that enable writes,
			 * so enabling them is a no-op too.
			 */
			buck1_reg: BUCK1 {
				regulator-name = "vdd_mif";
				regulator-always-on;
			};

			buck2_reg: BUCK2 {
				regulator-name = "vdd_cpucl0";
				regulator-always-on;
			};

			buck3_reg: BUCK3 {
				regulator-name = "vdd_cpucl1_2";
				regulator-always-on;
			};

			buck4_reg: BUCK4 {
				regulator-name = "vdd_int";
				regulator-always-on;
			};

			buck5_reg: BUCK5 {
				regulator-name = "vdd_g3d";
			};

			buck6_reg: BUCK6 {
				regulator-name = "vdd2_mem";
				regulator-always-on;
			};

			buck7_reg: BUCK7 {
				regulator-name = "vdd_lldo";
			};

			buck8_reg: BUCK8 {
				regulator-name = "vdd_mldo";
				regulator-always-on;
			};

			ldo1_reg: LDO1 {
				regulator-name = "vdd_ldo1";
			};

			ldo2_reg: LDO2 {
				regulator-name = "vqmmc";
			};

			ldo3_reg: LDO3 {
				regulator-name = "vdd_ldo3";
				regulator-always-on;
			};

			ldo4_reg: LDO4 {
				regulator-name = "vdd_ldo4";
				regulator-always-on;
			};

			ldo5_reg: LDO5 {
				regulator-name = "vdd_ldo5";
				regulator-always-on;
			};

			ldo6_reg: LDO6 {
				regulator-name = "vdd_ldo6";
				regulator-always-on;
			};

			ldo7_reg: LDO7 {
				regulator-name = "vdd_ldo7";
				regulator-always-on;
			};

			ldo8_reg: LDO8 {
				regulator-name = "vdd_ldo8";
				regulator-always-on;
			};

			ldo9_reg: LDO9 {
				regulator-name = "vdd_ldo9";
				regulator-always-on;
			};

			ldo10_reg: LDO10 {
				regulator-name = "vdd_ldo10";
				regulator-always-on;
			};

			ldo11_reg: LDO11 {
				regulator-name = "vdd_ldo11";
				regulator-always-on;
			};

			ldo12_reg: LDO12 {
				regulator-name = "vdd_ldo12";
				regulator-always-on;
			};

			ldo13_reg: LDO13 {
				regulator-name = "vdd_ldo13";
				regulator-always-on;
			};

			ldo14_reg: LDO14 {
				regulator-name = "vdd_ldo14";
				regulator-always-on;
			};

			ldo33_reg: LDO33 {
				regulator-name = "vdd_ldo33";
			};

			ldo34_reg: LDO34 {
				regulator-name = "vdd_ldo34";
			};

			ldo35_reg: LDO35 {
				regulator-name = "vmmc";
			};

			ldo36_reg: LDO36 {
				regulator-name = "vdd_ldo36";
			};

			ldo37_reg: LDO37 {
				regulator-name = "vdd_ldo37";
			};
		};
	};
};

&gpu {
	/*
	 * No mali-supply: vdd_g3d (buck5) is ACPM-owned and not host-settable,
	 * so the GPU rail is left to firmware and devfreq does frequency-only
	 * DVFS (see the gpu_opp_table in the SoC dtsi).
	 */
	status = "okay";
};
