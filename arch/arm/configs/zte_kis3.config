# ZTE Open C / Kis 3 (MSM8210), on top of qcom_defconfig:
#   make ARCH=arm qcom_defconfig zte_kis3.config
#
# The kernel is booted by lk2nd, which passes its patched DTB (memory,
# cmdline, simplefb, ramoops) in r2; an appended DTB would override it.
# CONFIG_ARM_APPENDED_DTB is not set

# lk2nd places the DTB at 0x01e00000 and the ramdisk at 0x02000000 on
# msm8610. The decompressed kernel plus the relocated zImage must stay
# below that, so drop what this board does not use yet.
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_FTRACE is not set
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_HID is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_ETHERNET is not set
# CONFIG_IPV6 is not set

# LZ4 decompresses ~0.3 s faster than gzip at boot; the zImage grows
# from 6.3 to 7.3 MiB, which still fits below the DTB
CONFIG_KERNEL_LZ4=y

# USB gadget networking for the postmarketOS initramfs (RNDIS is what
# the host side expects)
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y

# Kernel log survives a reset; lk2nd reads it with "fastboot oem ramoops"
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Framebuffer console on lk2nd's simplefb
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y

# postmarketOS userspace
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y
CONFIG_INPUT_EVDEV=y
CONFIG_ZRAM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UEVENT_HELPER=y
CONFIG_SQUASHFS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# CPU frequency scaling statistics and manual control for testing
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y

# Throttle the CPUs when tsens reports them hot
CONFIG_CPU_THERMAL=y

# CPU power collapse in idle (SPM + TZ)
CONFIG_ARM_QCOM_SPM_CPUIDLE=y

# PM8110 power key and volume down (RESIN)
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y

# "reboot bootloader" etc. through the IMEM restart reason
CONFIG_SYSCON_REBOOT_MODE=y

# PM8110 ADCs (battery voltage/current/temperature) and die temperature
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_IADC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
# CONFIG_IIO_SW_TRIGGER is not set
# CONFIG_IIO_HRTIMER_TRIGGER is not set
# CONFIG_KXSD9 is not set
# CONFIG_MPU3050_I2C is not set
# CONFIG_AK8975 is not set
# CONFIG_BMP280 is not set

# PM8110 coulomb counting fuel gauge and battery thermistor
CONFIG_BATTERY_PM8110_BMS=y
CONFIG_GENERIC_ADC_THERMAL=y

# ADSP: the firmware is on the rootfs, so load the PAS driver after it is mounted
CONFIG_QCOM_Q6V5_PAS=m

# Audio via the QDSP6 services on the ADSP
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_MSM_LPASSCC_8610=m
CONFIG_SND_SOC_APQ8016_SBC=m
CONFIG_SND_SOC_MSM8610_WCD=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m

# WCNSS (Pronto + WCN3620) Bluetooth and WLAN: the firmware is on the
# rootfs, as for the ADSP
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_BT=m
CONFIG_BT_QCOMSMD=m
# CONFIG_BT_HCIUART is not set
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
# CONFIG_BRCMFMAC is not set
# CONFIG_RTL_CARDS is not set

# Modem: the firmware is on the rootfs, as for the ADSP. QRTR carries
# the remote filesystem service (served by rmtfs) and QMI, BAM-DMUX
# the mobile data
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_SYSMON=m
CONFIG_WWAN=m
CONFIG_RPMSG_WWAN_CTRL=m
CONFIG_QCOM_BAM_DMUX=m
