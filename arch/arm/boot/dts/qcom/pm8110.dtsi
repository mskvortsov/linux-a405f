#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/spmi/spmi.h>

&spmi_bus {
	pm8110_0: pmic@0 {
		compatible = "qcom,pm8110", "qcom,spmi-pmic";
		reg = <0x0 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Only reads the USB_CHGPTH "usbin-valid" interrupt line state */
		pm8110_usb_vbus: usb-detect@1300 {
			compatible = "qcom,pm8941-misc";
			reg = <0x1300>;
			interrupts = <0x0 0x13 0x1 IRQ_TYPE_EDGE_BOTH>;
			interrupt-names = "usb_vbus";
		};
	};

	pm8110_1: pmic@1 {
		compatible = "qcom,pm8110", "qcom,spmi-pmic";
		reg = <0x1 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8110_spmi_regulators: regulators {
			compatible = "qcom,pm8110-regulators";
		};
	};
};
