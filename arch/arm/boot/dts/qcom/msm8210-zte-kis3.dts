#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "qcom-msm8610.dtsi"
#include "pm8110.dtsi"

/ {
	model = "ZTE Open C / Kis 3";
	compatible = "zte,kis3", "qcom,msm8210", "qcom,msm8610";
	chassis-type = "handset";

	qcom,msm-id = <162 0x10001>;
	qcom,board-id = <11 0>;

	aliases {
		mmc0 = &sdhc_1;
		serial0 = &blsp1_uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&gpio_keys_default>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <&tlmm 72 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};
};

&blsp1_uart2 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&pm8110_s2>;
};

&cpu1 {
	cpu-supply = <&pm8110_s2>;
};

&pm8110_charger {
	/* The bootloader locks the safe limits at these values */
	qcom,fast-charge-safe-current = <1000000>;
	qcom,fast-charge-current-limit = <1000000>;
	qcom,fast-charge-safe-voltage = <4200000>;
	qcom,fast-charge-high-threshold-voltage = <4200000>;
	qcom,auto-recharge-threshold-voltage = <4100000>;
	qcom,minimum-input-voltage = <4300000>;
	usb-charge-current-limit = <500000>;

	status = "okay";
};

&pm8110_resin {
	linux,code = <KEY_VOLUMEDOWN>;

	status = "okay";
};

&pm8110_spmi_regulators {
	/* CPU (APC) rail */
	pm8110_s2: s2 {
		regulator-min-microvolt = <1150000>;
		regulator-max-microvolt = <1275000>;
		regulator-always-on;
	};
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-pm8110-regulators";

		/*
		 * Only rails with a known use are listed, at the downstream
		 * voltages; the rest are left to the RPM and other masters.
		 */

		/*
		 * Memory (MX) rail; must not be below the CPU corner
		 * ceiling, which is 1.275 V for the turbo frequencies
		 */
		pm8110_l3: l3 {
			regulator-min-microvolt = <1275000>;
			regulator-max-microvolt = <1275000>;
			regulator-always-on;
		};

		/* DSI; no display driver yet, keep the bootloader setup alive */
		pm8110_l4: l4 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-always-on;
		};

		/* 1.8V I/O: eMMC pads, display, audio, WCNSS */
		pm8110_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		/* PLLs (incl. CPU), USB PHY, WCNSS */
		pm8110_l10: l10 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		/* Panel and I2C peripherals I/O */
		pm8110_l14: l14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
		};

		/* eMMC */
		pm8110_l17: l17 {
			regulator-min-microvolt = <2900000>;
			regulator-max-microvolt = <2900000>;
			regulator-always-on;
		};

		/* DSI analog, sensors */
		pm8110_l19: l19 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
			regulator-always-on;
		};

		/* USB PHY */
		pm8110_l20: l20 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
		};
	};
};

&sdhc_1 {
	vmmc-supply = <&pm8110_l17>;
	vqmmc-supply = <&pm8110_l6>;

	status = "okay";
};

&usb {
	dr_mode = "peripheral";
	extcon = <&pm8110_charger>;

	status = "okay";
};

&usb_hs_phy {
	extcon = <&pm8110_charger>;
	v1p8-supply = <&pm8110_l10>;
	v3p3-supply = <&pm8110_l20>;

	qcom,init-seq = /bits/ 8 <0x0 0x44 0x1 0x6a 0x2 0x34 0x3 0x13>;
};

&tlmm {
	gpio_keys_default: gpio-keys-default-state {
		pins = "gpio72";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};
